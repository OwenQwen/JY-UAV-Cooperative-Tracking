      <static>true</static>
      <pose>8 20 0.35 0 0 0</pose>
      <link name="body">
        <visual name="body_visual">
          <geometry><box><size>4.5 2.0 1.0</size></box></geometry>
          <material>
            <ambient>0.7 0.15 0.15 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <pose>0 0 0.5 0 0 0</pose>
      </link>
      <link name="cabin">
        <visual name="cabin_visual">
          <geometry><box><size>2.2 1.8 0.55</size></box></geometry>
          <material>
            <ambient>0.15 0.5 0.8 1</ambient>
            <diffuse>0.2 0.6 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <pose>0 0 1.15 0 0 0</pose>
      </link>
      <link name="wheel_fl">
        <visual name="wheel_visual">
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <pose>1.6 1.15 0.3 1.5708 0 0</pose>
      </link>
      <link name="wheel_fr">
        <visual name="wheel_visual">
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <pose>1.6 -1.15 0.3 1.5708 0 0</pose>
      </link>
      <link name="wheel_rl">
        <visual name="wheel_visual">
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <pose>-1.6 1.15 0.3 1.5708 0 0</pose>
      </link>
      <link name="wheel_rr">
        <visual name="wheel_visual">
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <pose>-1.6 -1.15 0.3 1.5708 0 0</pose>
      </link>
    </model>

    <wind>
      <linear_velocity>-7 -7 0</linear_velocity>
    </wind>

    <!-- ===== DRONE MARKER: red circle below drone ===== -->
    <model name="drone_marker">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>2.5</radius><length>0.08</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.1 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 20 0.03 0 0 0</pose>
    </model>

    <!-- ===== X500 DRONE: parked in front of library ===== -->
    <include>
      <uri>model://x500</uri>
      <pose>0 20 0.3 0 0 0</pose>
    </include>

  </world>
</sdf>